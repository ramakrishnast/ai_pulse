# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: Docker Compose treats text after "KEY=" as the value,
# so an inline comment after an empty value becomes the value.

# --- LLM (summaries, digest, Ask the news)
# Provider: openai | anthropic | none
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
# Calls to any other model are refused
LLM_ALLOWED_MODELS=gpt-6-luna
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint
# OPENAI_BASE_URL=
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Spend guard (USD). The app refuses any call that could push spend past these caps,
# assuming the worst case (every allowed output token used). Spend is tracked in the DB.
# Lifetime cap: pipeline runs + digests + Ask the news
LLM_BUDGET_USD_TOTAL=0.15
# Cap for one daily run
LLM_BUDGET_USD_PER_RUN=0.02
# USD per 1M tokens - verify on OpenAI's pricing page
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
# Optional, only if the model supports it (fewer billed tokens)
# LLM_REASONING_EFFORT=low

# --- Call/token caps (per pipeline run)
LLM_MAX_CALLS_PER_RUN=20
LLM_MAX_TOKENS_PER_RUN=400000
# Stories summarized per LLM call
ENRICH_BATCH_SIZE=8
ENRICH_MAX_STORIES_PER_RUN=200
# Summarize stories from the last N days (highest-ranked first)
ENRICH_WINDOW_DAYS=7

# --- When to run
# Defines "today", e.g. Asia/Kolkata or America/New_York
APP_TIMEZONE=UTC
# First visit of the day fetches + processes today's news
AUTO_RUN_ON_OPEN=true
# Optional extra daily run, 5-field cron, e.g. 0 6 * * *  (leave empty to disable)
SCHEDULE_CRON=

# --- Embeddings / clustering
# auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Cosine similarity thresholds (defaults depend on the embedding backend)
# DEDUPE_THRESHOLD=0.90
# CLUSTER_THRESHOLD=0.70
CLUSTER_WINDOW_DAYS=3

# --- Server
# Set when exposed on the internet (HTTP Basic auth, any username). Empty = no password.
APP_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8000
# Or postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:////app/data/ai_pulse.db

# --- Optional email digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
