# Copy to .env and fill in. Never commit .env.

# --- LLM (summaries, digest, Ask the news)
LLM_PROVIDER=openai            # openai | anthropic | none
LLM_MODEL=gpt-6-luna
LLM_ALLOWED_MODELS=gpt-6-luna  # calls to any other model are refused
OPENAI_API_KEY=
# OPENAI_BASE_URL=             # optional: OpenAI-compatible endpoint
ANTHROPIC_API_KEY=             # used when LLM_PROVIDER=anthropic (e.g. LLM_MODEL=claude-haiku-5-5)

# --- Spend guard (USD). The app refuses any call that could push spend past these caps,
# assuming the worst case (every allowed output token used). Spend is tracked in the DB.
LLM_BUDGET_USD_TOTAL=0.15      # lifetime cap: pipeline runs + digests + Ask the news
LLM_BUDGET_USD_PER_RUN=0.02    # cap for one daily run
LLM_PRICE_INPUT_PER_MTOK=0.10  # USD per 1M input tokens - verify on OpenAI's pricing page
LLM_PRICE_OUTPUT_PER_MTOK=0.50 # USD per 1M output tokens
# LLM_REASONING_EFFORT=low     # optional, only if the model supports it (fewer billed tokens)

# --- Call/token caps (per pipeline run)
LLM_MAX_CALLS_PER_RUN=20
LLM_MAX_TOKENS_PER_RUN=400000
ENRICH_BATCH_SIZE=8            # stories summarized per LLM call
ENRICH_MAX_STORIES_PER_RUN=200
ENRICH_WINDOW_DAYS=7           # summarize stories from the last N days (highest-ranked first)

# --- When to run
APP_TIMEZONE=UTC               # e.g. Asia/Kolkata, America/New_York — defines "today"
AUTO_RUN_ON_OPEN=true          # first visit of the day fetches + processes today's news
SCHEDULE_CRON=                 # optional, e.g. "0 6 * * *" to also run at 06:00 daily

# --- Embeddings / clustering
EMBEDDING_BACKEND=auto         # auto | sentence-transformers | hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DEDUPE_THRESHOLD=0.90        # cosine similarity for near-duplicates
# CLUSTER_THRESHOLD=0.70       # cosine similarity for "same story"
CLUSTER_WINDOW_DAYS=3

# --- Server
APP_PASSWORD=                  # set when exposed on the internet (HTTP Basic auth, any username)
PUBLIC_BASE_URL=http://localhost:8000
# DATABASE_URL=sqlite:////app/data/ai_pulse.db   # or postgresql+psycopg://user:pass@host/db

# --- Optional email digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
